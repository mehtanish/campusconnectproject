# Campus Connect Environment Variables

# Spring Boot Port
PORT=8080

# JWT Authentication
APP_JWT_SECRET=campusPulseSecretKeyForJWTAuthenticationThatIsAtLeast256BitsLong2024!
APP_JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# File Upload Directory
APP_UPLOAD_DIR=./uploads
